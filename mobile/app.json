{
  "expo": {
    "name": "MedTerm Study",
    "slug": "tea",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "splash": {
      "backgroundColor": "#0F766E"
    },

    "icon": "./assets/icon.png",

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.teacy.medtermstudy",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.teacy.medtermstudy"
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },

    "plugins": [
      "expo-audio",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedTermRx to scan medical terminology."
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "f901881f-d5f3-4371-b773-5eb570f8dc2a"
      }
    },

    "owner": "teacy",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/f901881f-d5f3-4371-b773-5eb570f8dc2a"
    }
  }
}